{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "festival-vehicle-tracking",
  "main": "src/index.ts",
  // 同梱の workerd（wrangler 4.151.0）が対応する最新日付
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "festival-vehicle-tracking",
      // `wrangler d1 create festival-vehicle-tracking --location=apac`（2026-10-14・APAC）で作成。UUID は秘密ではない
      "database_id": "2f0035db-663b-4613-9e3d-77f2dbd8714e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 閲覧APIを読めるページのOrigin（scheme + host のみ・パスなし・カンマ区切り）。ローカル開発用は .dev.vars で上書きする
    "ALLOWED_ORIGINS": "https://ysnagaeiku-byte.github.io"
  },
  "observability": {
    "enabled": true,
    // 送信用の秘密キーはURLに含まれるため、URLを自動記録する invocation log は使わない
    "logs": { "invocation_logs": false }
  }
}
